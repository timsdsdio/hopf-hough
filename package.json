{
  "name": "hopf-hough",
  "version": "0.1.0",
  "description": "Exact retarded Li\u00e9nard\u2013Wiechert fields of moving point charges, evaluated per pixel on the GPU (WebGL2), with a built-in double-precision accuracy check.",
  "type": "module",
  "license": "MIT",
  "author": "Tim Huff",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/lib/core/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:gpu": "node tests/gpu/run.mjs",
    "test:legacy-full": "node tests/gpu/legacy_regression.mjs dist/hopf-hough.iife.js",
    "tables": "node tests/gpu/tables.mjs all"
  },
  "keywords": [
    "electromagnetism",
    "lienard-wiechert",
    "retarded-potentials",
    "webgl2",
    "gpu",
    "physics",
    "synchrotron-radiation"
  ],
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timsdsdio/hopf-hough.git"
  },
  "homepage": "https://timsdsdio.github.io/hopf-hough/"
}
