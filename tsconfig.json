{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist/lib",
    "rootDir": "src",
    "sourceMap": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
